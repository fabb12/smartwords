            "marks": [
              {
                "type": "textStyle",
                "attrs": {
                  "backgroundColor": null,
                  "color": null,
                  "fontFamily": null,
                  "fontSize": "18px",
                  "lineHeight": null
                }
              }
            ],
            "text": " enorme a dispetto di quella più grande, come se il tempo che ancora hai davanti fosse una ricchezza che l'altra ha già speso."
          }
        ]
      },
      {
        "type": "paragraph",
        "attrs": {
          "textAlign": null
        },
        "content": [
