                  "fontSize": "18px",
                  "lineHeight": null
                }
              },
              {
                "type": "italic"
              }
            ],
            "text": "una promessa, non un possesso"
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "textStyle",
                "attrs": {
                  "backgroundColor": null,
                  "color": null,
                  "fontFamily": null,
                  "fontSize": "18px",
                  "lineHeight": null
                }
              }
            ],
            "text": ", e che chi ti stava davanti aveva già fatto i conti con ciò che a te restava ancora da scoprire. Solo quando ti ritrovi dall'altra parte ti rendi conto davvero che quel "
          },
          {
            "type": "text",
            "marks": [
              {
