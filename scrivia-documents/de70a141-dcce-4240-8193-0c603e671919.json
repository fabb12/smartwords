                  "fontFamily": null,
                  "fontSize": "18px",
                  "lineHeight": null
                }
              }
            ],
            "text": "Solo più tardi capisci che quel potenziale era "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "textStyle",
                "attrs": {
                  "backgroundColor": null,
