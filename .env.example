# Configure as a secret in Sites. Never commit the actual value.
# Generate a cryptographically random value of at least 32 characters.
VAULT_MASTER_KEY=

# Account cloud (Supabase) per la versione GitHub Pages e per l'app desktop: vedi README, sezione «Account e cloud».
# Sono valori pubblici (URL del progetto e chiave «anon»): la protezione dei dati è data da supabase/schema.sql.
# Per provare in locale copiali in un file .env.local; per la pubblicazione impostali come Variables in GitHub Actions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
